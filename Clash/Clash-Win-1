port: 7890
socks-port: 7891
redir-port: 7892
mixed-port: 7893

allow-lan: true
bind-address: "*"
mode: rule
log-level: warning
ipv6: false
find-process-mode: 'off'
external-controller: '127.0.0.1:9090'

unified-delay: true
tcp-concurrent: true
global-client-fingerprint: chrome
keep-alive-idle: 30
keep-alive-interval: 15
disable-keep-alive: false

sniffer:
  enable: false
  sniff:
    HTTP:
      ports: []
      override-destination: true
    TLS:
      ports:
        - 443
        - 8443
    QUIC:
      ports:
        - 443
        - 8443

tun:
  enable: true
  stack: mixed
  dns-hijack:
    - any:53
    - tcp://any:53
  auto-route: true
  auto-redirect: true
  auto-detect-interface: true

profile:
  store-selected: true
  store-fake-ip: false  

dns:
  enable: true
  cache-algorithm: arc
  prefer-h3: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter-mode: blacklist
  fake-ip-filter:
    - +.lan
    - +.local
    - +.localhost
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
  fallback:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query
  fallback-filter:
    geoip: true
    geoip-code: CN
    ipcidr:
      - 240.0.0.0/4


proxies:


proxy-groups:
  - name: 策略模式
    type: select
    proxies: []

  - name: 手动模式
    type: select
    proxies: []

  - name: 优选模式
    type: url-test
    lazy: true
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    proxies: []

  - name: 谷歌服务
    type: select
    proxies: [策略模式, 优选模式]

  - name: 推特服务
    type: select
    proxies: [策略模式, 优选模式]

  - name: 飞机服务
    type: select
    proxies: [策略模式, 优选模式]

  - name: 加密服务
    type: select
    proxies: [手动模式, 优选模式]

  - name: 智能服务
    type: select
    proxies: [手动模式, 优选模式]

  - name: 微软服务
    type: select
    proxies: [策略模式, 优选模式]

  - name: 直连模式
    type: select
    proxies: [DIRECT]

  - name: 禁止模式
    type: select
    proxies: [REJECT]

rules:
  - RULE-SET,局域网络,直连模式
  - RULE-SET,规则修正,直连模式
  - RULE-SET,屏蔽服务,禁止模式
  - RULE-SET,禁止广告,禁止模式
  - RULE-SET,反劫服务,禁止模式
  - RULE-SET,隐私保护,禁止模式

  - RULE-SET,谷歌服务,谷歌服务
  - RULE-SET,推特服务,推特服务
  - RULE-SET,飞机服务,飞机服务
  - RULE-SET,加密服务,加密服务
  - RULE-SET,智能服务,智能服务
  - RULE-SET,微软服务,微软服务

  - RULE-SET,国际服务,策略模式
  - RULE-SET,国内服务,直连模式
  - GEOIP,CN,直连模式
  - MATCH,策略模式

