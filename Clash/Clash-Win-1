mixed-port: 7890

allow-lan: true
bind-address: '*'
mode: rule
log-level: warning
ipv6: false
external-controller: 127.0.0.1:9090

unified-delay: true
tcp-concurrent: true
find-process-mode: off
keep-alive-idle: 600
keep-alive-interval: 15
disable-keep-alive: false

geox-url:
  asn: https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/GeoLite2-ASN.mmdb
  geoip: https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.dat
  geosite: https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geosite.dat
  mmdb: https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.metadb

profile:
  store-selected: true
  store-fake-ip: true

sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443, 8443]

tun:
  enable: true
  stack: mixed
  dns-hijack:
    - any:53
    - tcp://any:53
  auto-route: true
  auto-redirect: true
  auto-detect-interface: true

dns:
  enable: true
  prefer-h3: true
  listen: 0.0.0.0:1053
  use-hosts: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 28.0.0.1/8
  fake-ip-filter:
    - "*"
    - +.lan
  default-nameserver:
    - 223.5.5.5
    - 223.6.6.6
  nameserver:
    - https://223.5.5.5/dns-query
    - https://223.6.6.6/dns-query


proxies:


proxy-groups:
  - name: 策略模式
    type: select
    proxies: []

  - name: 手动模式
    type: select
    proxies: []

  - name: 优选模式
    type: url-test
    tolerance: 50
    proxies: []
    url: https://www.gstatic.com/generate_204
    interval: 300

  - name: 谷歌服务
    type: select
    proxies: [策略模式, 手动模式]

  - name: 智能服务
    type: select
    proxies: [策略模式, 手动模式]

  - name: 加密服务
    type: select
    proxies: [策略模式, 手动模式]

  - name: 推特服务
    type: select
    proxies: [策略模式, 手动模式]

  - name: 飞机服务
    type: select
    proxies: [策略模式, 手动模式]

  - name: 微软服务
    type: select
    proxies: [策略模式, 手动模式]

  - name: 游戏服务
    type: select
    proxies: [策略模式, 优选模式]

  - name: 直连模式
    type: select
    proxies: [DIRECT]

  - name: 禁止模式
    type: select
    proxies: [REJECT]

rules:
  - RULE-SET,规则修正,直连模式
  - RULE-SET,屏蔽服务,禁止模式
  - RULE-SET,禁止广告,禁止模式
  - RULE-SET,反劫服务,禁止模式
  - RULE-SET,隐私保护,禁止模式

  - RULE-SET,谷歌服务,谷歌服务
  - RULE-SET,智能服务,智能服务
  - RULE-SET,加密服务,加密服务
  - RULE-SET,推特服务,推特服务
  - RULE-SET,飞机服务,飞机服务
  - RULE-SET,微软服务,微软服务

  - RULE-SET,游戏下载1,直连模式
  - RULE-SET,游戏下载2,直连模式
  - RULE-SET,游戏服务,游戏服务

  - RULE-SET,国际服务,策略模式
  - RULE-SET,国内服务,直连模式
  - RULE-SET,局域网络,直连模式
  - GEOIP,CN,直连模式
  - MATCH,策略模式

