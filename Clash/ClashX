    icon: null

  - name: 美国
    type: url-test
    tolerance: 50
    use:
      - A
    include-all: true
    filter: (?i)(🇺🇸|US|USA|United.?States|美国)
    url: https://www.gstatic.com/generate_204
    interval: 300
    icon: null

