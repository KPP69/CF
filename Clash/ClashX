mixed-port: 7890
allow-lan: true
bind-address: '*'

mode: rule
log-level: info
ipv6: false
find-process-mode: off

unified-delay: true
tcp-concurrent: true

external-controller: 127.0.0.1:9090

profile:
  store-selected: true
  store-fake-ip: true

geodata-mode: false
geo-auto-update: true
geo-update-interval: 24
geox-url:
  asn: https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/GeoLite2-ASN.mmdb
  geoip: https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.dat
  geosite: https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geosite.dat
  mmdb: https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.metadb

sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443, 8443]

tun:
  enable: true
  stack: mixed
  dns-hijack:
    - any:53
    - tcp://any:53
  auto-route: true
  auto-redirect: true
  auto-detect-interface: true

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  use-hosts: true
  use-system-hosts: true
  prefer-h3: false
  default-nameserver:
    - 119.29.29.29
    - 223.5.5.5
    - 1.1.1.1
    - 8.8.8.8
  nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
    - https://cloudflare-dns.com/dns-query
    - https://dns.google/dns-query
  fake-ip-filter:
    - +.lan
    - +.local


proxy-providers:
  A:
    type: http
    url: ""
    interval: 86400


proxy-groups:
  - name: 策略模式
    type: select
    proxies: [优选模式, 香港, 狮城, 日本, 台湾, 美国]

  - name: 优选模式
    type: url-test
    tolerance: 50
    use:
      - A
    include-all: true
    url: https://www.gstatic.com/generate_204
    interval: 300


  - name: 苹果服务
    type: select
    proxies: [直连模式, 优选模式, 香港, 狮城, 日本, 台湾, 美国]

  - name: 谷歌服务
    type: select
    proxies: [策略模式, 优选模式, 香港, 狮城, 日本, 台湾, 美国]

  - name: 智能服务
    type: select
    proxies: [策略模式, 优选模式, 香港, 狮城, 日本, 台湾, 美国]

  - name: 推特服务
    type: select
    proxies: [策略模式, 优选模式, 香港, 狮城, 日本, 台湾, 美国]

  - name: 飞机服务
    type: select
    proxies: [策略模式, 优选模式, 香港, 狮城, 日本, 台湾, 美国]

  - name: 加密服务
    type: select
    proxies: [策略模式, 优选模式, 香港, 狮城, 日本, 台湾, 美国]

  - name: 抖音服务
    type: select
    proxies: [策略模式, 优选模式, 香港, 狮城, 日本, 台湾, 美国]

  - name: Spotify
    type: select
    proxies: [策略模式, 优选模式, 香港, 狮城, 日本, 台湾, 美国]

  - name: Ins Ins
    type: select
    proxies: [策略模式, 优选模式, 香港, 狮城, 日本, 台湾, 美国]

  - name: 微软服务
    type: select
    proxies: [策略模式, 优选模式, 香港, 狮城, 日本, 台湾, 美国]


  - name: 直连模式
    type: select
    proxies: [DIRECT]

  - name: 禁止模式
    type: select
    proxies: [REJECT]


  - name: 香港
    type: url-test
    tolerance: 50
    use:
      - A
    include-all: true
    filter: (?i)(🇭🇰|HK|Hong.?Kong|香港)
    url: https://www.gstatic.com/generate_204
    interval: 300

  - name: 狮城
    type: url-test
    tolerance: 50
    use:
      - A
    include-all: true
    filter: (?i)(🇸🇬|SG|Singapore|新加坡|狮城)
    url: https://www.gstatic.com/generate_204
    interval: 300

  - name: 日本
    type: url-test
    tolerance: 50
    use:
      - A
    include-all: true
    filter: (?i)(🇯🇵|JP|Japan|日本|东京|大阪)
    url: https://www.gstatic.com/generate_204
    interval: 300

  - name: 台湾
    type: url-test
    tolerance: 50
    use:
      - A
    include-all: true
    filter: (?i)(🇨🇳|🇹🇼|TW|Taiwan|台湾|台北)
    url: https://www.gstatic.com/generate_204
    interval: 300

  - name: 美国
    type: url-test
    tolerance: 50
    use:
      - A
    include-all: true
    filter: (?i)(🇺🇸|US|USA|United.?States|美国)
    url: https://www.gstatic.com/generate_204
    interval: 300

