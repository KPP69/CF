  - name: 加密服务
    type: select
    proxies: [策略模式, 优选模式, 香港, 狮城, 日本, 台湾, 美国]
    icon:

  - name: 智能服务
    type: select
    proxies: [策略模式, 优选模式, 香港, 狮城, 日本, 台湾, 美国]
    icon:

  - name: 抖音服务
    type: select
    proxies: [策略模式, 优选模式, 香港, 狮城, 日本, 台湾, 美国]
    icon:

  - name: Spotify
    type: select
    proxies: [策略模式, 优选模式, 香港, 狮城, 日本, 台湾, 美国]
    icon:

  - name: Ins Ins
    type: select
    proxies: [策略模式, 优选模式, 香港, 狮城, 日本, 台湾, 美国]
    icon:

  - name: 微软服务
    type: select
    proxies: [策略模式, 优选模式, 香港, 狮城, 日本, 台湾, 美国]
    icon:

  - name: 直连模式
    type: select
    proxies: [DIRECT]
    icon:

  - name: 禁止模式
    type: select
    proxies: [REJECT]
    icon:


  - name: 香港
    type: url-test
    include-all: true
    filter: (?i)(🇭🇰|HK|Hong.?Kong|香港)
